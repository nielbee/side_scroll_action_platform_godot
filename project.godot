[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player_body"
2d_physics/layer_3="player_hitbox"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_body"
2d_physics/layer_6="enemy_hitbox"
2d_physics/layer_7="enemy_hurtbox"
2d_physics/layer_8="interactable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/default_filters/anisotropic_filtering_level=0
textures/decals/filter=0
textures/light_projectors/filter=0
